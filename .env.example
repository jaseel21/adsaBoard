# ADSA T-Board Environment Configuration Template
# Copy this file to .env.local to configure local development settings

# Optional default email to prefill on Admin Login (leave blank for clean inputs)
VITE_ADMIN_DEFAULT_EMAIL=

# Direct Email Delivery Options (Zero Firebase Blaze Plan Required)
# Option 1: Google Apps Script Webhook (Free Gmail dispatch from script.google.com)
VITE_EMAIL_WEBHOOK_URL=

# Option 2: EmailJS (Connects to Gmail SMTP with 16-character Google App Password)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
