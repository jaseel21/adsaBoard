rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // SECURITY HELPER FUNCTIONS
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isStaff() {
      return isAuthenticated() && exists(/databases/$(database)/documents/staff_users/$(request.auth.uid));
    }

    function getStaffData() {
      return get(/databases/$(database)/documents/staff_users/$(request.auth.uid)).data;
    }

    function getStaffRole() {
      return getStaffData().role;
    }

    function isDeveloper() {
      return isStaff() && getStaffRole() == 'developer';
    }

    function isCentralCommittee() {
      return isStaff() && (getStaffRole() == 'central_committee' || getStaffRole() == 'developer');
    }

    function isCanteenCommittee() {
      return isStaff() && (
        getStaffRole() == 'canteen_committee' ||
        getStaffRole() == 'central_committee' ||
        getStaffRole() == 'developer'
      );
    }

    function isCook() {
      return isStaff() && (
        getStaffRole() == 'cook' ||
        getStaffRole() == 'canteen_committee' ||
        getStaffRole() == 'central_committee' ||
        getStaffRole() == 'developer'
      );
    }

    // ==========================================
    // 1. STAFF USERS DIRECTORY & RBAC
    // ==========================================
    match /staff_users/{userId} {
      // Secure directory read: Authenticated users only (no anonymous public enumeration)
      allow read: if isAuthenticated();
      
      // Dynamic Seeding & Creation:
      // - Super Admin / Developer has full creation capability
      // - Designated seed account (navarmp@gmail.com) can bootstrap developer role
      // - Central Committee can provision sub-committee and kitchen staff (cannot self-escalate to developer)
      allow create: if isAuthenticated() && (
        isDeveloper() ||
        request.auth.token.email == 'navarmp@gmail.com' ||
        (isCentralCommittee() && request.resource.data.role != 'developer' && request.resource.data.isSuperAdmin != true)
      );

      // Updates & Revocations:
      // - Developers / Super Admins can update or delete any record
      // - Designated seed account (navarmp@gmail.com) can self-heal/update their own profile
      // - Central Committee can manage only non-developer staff (cannot edit/delete Super Admins)
      allow update: if isAuthenticated() && (
        isDeveloper() ||
        (request.auth.uid == userId && request.auth.token.email == 'navarmp@gmail.com') ||
        (
          isCentralCommittee() &&
          resource.data.role != 'developer' &&
          resource.data.isSuperAdmin != true &&
          request.resource.data.role != 'developer' &&
          request.resource.data.isSuperAdmin != true
        )
      );

      allow delete: if isAuthenticated() && (
        isDeveloper() ||
        (isCentralCommittee() && resource.data.role != 'developer' && resource.data.isSuperAdmin != true)
      );
    }

    // ==========================================
    // 1B. AUTH USERS REGISTRY (User Selection Directory)
    // ==========================================
    match /auth_users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isCentralCommittee());
    }

    // ==========================================
    // 2. STUDENT RECORDS COLLECTION
    // ==========================================
    match /students/{studentId} {
      // Public / Display read for Token Board, Public Menu, and Kitchen Display
      allow read: if true;

      // Only Central Committee & Developers can create or delete student accounts
      allow create, delete: if isCentralCommittee();

      // Granular update rules based on role and field isolation:
      allow update: if 
        // A) Central Committee & Devs have full update capability
        isCentralCommittee() ||
        
        // B) Canteen Sub-Committee: Operational dining authority only (routines, exceptions, dietary, block/unblock).
        // Personal profile data (name, room, phone, batch, password, token number) cannot be altered.
        (
          isCanteenCommittee() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'obj',
            'obj2',
            'dietary',
            'dietaryNotes',
            'block',
            'blockReason',
            'dateExceptions',
            'templates',
            'diningHistory',
            'lastUpdatedBy',
            'updatedAt'
          ])
        ) ||
        
        // C) Student Self-Service: Strictly restricted to meal routine & calendar exceptions for non-blocked tokens.
        // Students CANNOT edit profile info (name, room, phone, batch, password, token, or block status).
        (
          resource.data.block == false &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'obj',
            'dateExceptions',
            'templates',
            'diningHistory',
            'lastUpdatedBy',
            'updatedAt'
          ]) &&
          // Enforce server timestamp integrity
          request.resource.data.updatedAt == request.time
        );
    }

    // ==========================================
    // 3. SYSTEM & TOKEN BOARD CONFIGURATION
    // ==========================================
    match /system_config/{configId} {
      // Everyone can read cutoff hours and emergency lock status
      allow read: if true;
      
      // Only Central Committee & Developers can change lock mode or cutoffs
      allow write: if isCentralCommittee();
    }

    match /tokenboard/{boardId} {
      // Public read for live cutoff schedule and locking status
      allow read: if true;
      
      // Only Central Committee & Developers can alter locking rules, cutoffs, or emergency overrides
      allow write: if isCentralCommittee();
    }

    // ==========================================
    // 4. CANTEEN MENU & DISH PRESETS
    // ==========================================
    match /menus/{menuId} {
      // Public read for daily/weekly menus
      allow read: if true;
      
      // Canteen Sub-Committee, Central Committee, and Developers can edit menus
      allow write: if isCanteenCommittee();
    }

    match /dish_presets/{presetId} {
      allow read: if true;
      allow write: if isCanteenCommittee();
    }

    match /menu_history/{historyId} {
      allow read: if isCanteenCommittee();
      allow write: if isCanteenCommittee();
    }

    // ==========================================
    // 5. DIETARY PREFERENCES & ALLERGENS
    // ==========================================
    match /dietary_preferences/{prefId} {
      allow read: if true;
      allow write: if isCanteenCommittee();
    }

    // ==========================================
    // 6. CENTRAL AUDIT TRAIL (IMMUTABLE LOGS)
    // ==========================================
    match /audit_logs/{logId} {
      // Audit logs are readable exclusively by Central Committee & Developers
      allow read: if isCentralCommittee();

      // Append-only: Authenticated staff and system actions can create log records
      allow create: if true;

      // IMMUTABILITY: Nobody (including developers) can edit or delete historical audit entries
      allow update, delete: if false;
    }
  }
}
